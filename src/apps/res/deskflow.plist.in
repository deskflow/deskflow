<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>English</string>
	<key>CFBundleExecutable</key>
	<string>@BUNDLE_EXECUTABLE_NAME@</string>
	<key>CFBundleGetInfoString</key>
	<string>@BUNDLE_INFO_STRING@</string>
	<key>CFBundleIconFile</key>
	<string>@BUNDLE_ICON_FILE@</string>
	<key>CFBundleIdentifier</key>
	<string>@BUNDLE_GUI_IDENTIFIER@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLongVersionString</key>
	<string>@CMAKE_PROJECT_VERSION@</string>
	<key>CFBundleName</key>
	<string>@BUNDLE_BUNDLE_NAME@</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@CMAKE_PROJECT_VERSION@</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>@CMAKE_PROJECT_VERSION@</string>
	<key>CSResourcesFileMapped</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>@BUNDLE_COPYRIGHT@</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>

	<!-- Prevent macOS from terminating during memory pressure -->
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>

	<!-- Local Lan Entitlements -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>This app uses local network permissions for communication between a Deskflow server and clients.</string>
	<key>com.apple.security.networking.local</key>
	<true/>

	<key>NSAppleEventsUsageDescription</key>
	<string>Deskflow reads the current browser tab when you choose to send it to another computer.</string>
	<key>NSServices</key>
	<array><dict>
		<key>NSMenuItem</key><dict><key>default</key><string>Send to computer…</string></dict>
		<key>NSMessage</key><string>sendToComputer</string>
		<key>NSPortName</key><string>Deskflow</string>
		<key>NSSendTypes</key><array><string>NSFilenamesPboardType</string><string>public.file-url</string><string>public.url</string></array>
	</dict></array>

	<!-- Accessibility Entitlements -->
	<key>com.apple.security.accessibility</key>
	<array>
		<dict>
			<key>com.apple.security.accessibility.read</key>
			<true/>
			<key>com.apple.security.accessibility.write</key>
			<true/>
			<key>com.apple.security.accessibility.execute</key>
			<true/>
		</dict>
	</array>
</dict>
</plist>
